# Deployer private key (never commit a real key). Read by script/Deploy.s.sol
PRIVATE_KEY=0x...
# Sepolia RPC endpoint used for deployment
SEPOLIA_RPC_URL=
# Etherscan API key used for contract verification
ETHERSCAN_API_KEY=

# Optional. Address that should own the protocol, normally a Safe multisig.
# Leave empty to keep the deployer as owner. The transfer is two-step: this address must still call
# acceptOwnership() on the protocol (from the Safe app) before it takes effect.
OWNER=
